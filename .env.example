# Add these only to server-side environment variables. Never prefix secrets with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
NEXT_PUBLIC_SUPABASE_URL=https://ofdidlumvcgynpdatpre.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_5jn0M7P4AlSnWjuhRwJrkg_z7xCr0mL
# A long random secret for signing booking proposals and session cookies.
SESSION_SECRET=replace-with-a-random-32-byte-secret

# Optional dashboard cost estimate. Set rates matching OPENAI_MODEL; blank disables it.
# These are uncached model-token rates only, excluding STT/TTS and hosting.
OPENAI_INPUT_USD_PER_MILLION=
OPENAI_OUTPUT_USD_PER_MILLION=

# Optional phone demo; see docs/phone-demo.md. Secrets stay server-side.
TWILIO_AUTH_TOKEN=
TWILIO_VOICE_WEBHOOK_URL=
TWILIO_RELAY_URL=
PHONE_PORT=3001

# Browser speech-to-speech. No separate STT/TTS steps for the main voice path.
OPENAI_REALTIME_MODEL=gpt-realtime
# Optional local registration adapter. Server-only; do not expose in the browser.
SUPABASE_SERVICE_ROLE_KEY=
